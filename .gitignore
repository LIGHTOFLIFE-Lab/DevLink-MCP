# --- 자격증명: 절대 커밋 금지 ---------------------------------
# DevLink-MCP 는 servers.ini 에 비밀번호를 평문으로 둡니다.
# 그 파일이 실수로도 저장소에 들어가지 않게 합니다.
servers.ini
*.pem
*.ppk
*.key
*.pfx
*.p12
id_rsa*
id_ed25519*
.env
keys/

# 예외: 비밀번호가 없는 예시 파일
!examples/servers.example.ini

# --- 작업 산출물 -----------------------------------------------
ssh-mcp-config.json
sites.json
sites/
repos/
logs/
*.log

# --- 파이썬 ----------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# --- 편집기·OS -------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.tmp

# Codespaces 데모가 만드는 폴더
.demo-home/

# 빌드 산출물 — 저장소가 아니라 릴리스로 배포한다.
# 15MB 짜리 바이너리를 커밋하면 이력에 영구히 쌓인다.
dist/
staging/
*.spec.bak
*.dmg
*.zip
*.tar.gz
*.sha256
