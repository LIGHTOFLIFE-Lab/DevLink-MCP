# Batch files must keep CRLF: cmd.exe mishandles multi-line parenthesised
# blocks in LF-only files.
*.cmd  text eol=crlf
*.bat  text eol=crlf

# PowerShell scripts need a UTF-8 BOM. Windows PowerShell 5.1 reads a
# BOM-less .ps1 as ANSI, which corrupts non-ASCII text and breaks parsing.
# Leave these files byte-for-byte alone.
*.ps1  -text

*.py   text eol=lf
*.sh   text eol=lf
*.md   text eol=lf

# Shipped next to the download and opened in Notepad. Keeps its BOM and CRLF so
# Windows renders it correctly; git must not normalise either.
packaging/FIRST-RUN.txt  -text

# Read by Python and by GitHub, never executed by Windows: keep LF so an
# editor on Windows cannot turn the whole file into a diff.
*.spec text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
